#!/usr/bin/env bash
# One command to check a change. Prints one line per step, keeps each step's
# log under target/verify/logs/, and writes target/verify/summary.md.
#
#   scripts/verify [--base REV]        just verify (fmt, lint, test), the
#                                      added-line check, and the recipes the
#                                      changed files need (see TRIGGERS)
#   scripts/verify full [--base REV]   everything CI runs (just ci), and the
#                                      added-line check
#   scripts/verify deep [--base REV]   the property and differential tests
#                                      with PROPTEST_CASES=100000, as deep.yml
#
# REV defaults to origin/main. Runs inside `nix develop`, which has the
# toolchains, Lean, TLA+, Go and wasmtime.
set -euo pipefail

root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
if [ -z "${IN_NIX_SHELL:-}" ]; then
  exec nix develop "$root" --command "$0" "$@"
fi
cd "$root"

mode=check
base=origin/main
while (($# > 0)); do
  case $1 in
  check | full | deep) mode=$1 ;;
  --base)
    base=${2:?--base needs a revision}
    shift
    ;;
  *)
    sed -n '2,/^set /p' "$0" | sed '$d; s/^# \{0,1\}//' >&2
    exit 2
    ;;
  esac
  shift
done
git rev-parse --verify --quiet "$base^{commit}" >/dev/null || base=main

# Changed file patterns (an extended regular expression on the path), the just
# recipes they need beyond `just verify`, and what else the change must do.
# This is the table docs/verification.md refers to.
TRIGGERS=(
  $'^crates/dictum/src/engine/(ops|fold|analysis|interp|compile|optimize)\\.rs$|^crates/dictum-check/src/\tdrt\tIf the semantics or typing changed, change formal/lean in the same change (docs/verification.md, "Connecting the proofs to the code").'
  $'^crates/dictum/src/engine/optimize\\.rs$\tdrt\tA new optimization, or a wider condition, is proved in formal/lean/Dictum/Opt first (docs/verification.md, "Optimizations, and the theorem that allows each").'
  $'^crates/dictum-syntax/src/(lexer|parser)\\.rs$\tdrt\tA precedence change also changes formal/lean/Dictum/Syntax.lean.'
  $'^formal/lean/\tdrt\t'
  $'^crates/dictum/src/(engine/(frame|set)|rule_set)\\.rs$|^formal/tla/\ttla\tIf sharing, caching or budgets behave differently, change formal/tla/RuleSetEval.tla and RuleSetTrace.tla.'
  $'^crates/dictum/src/(rule|rule_set)\\.rs$\ttla\tHot reload and Arc ownership are modeled in formal/tla/HotReload.tla.'
  $'^crates/(dictum|dictum-check|dictum-syntax|dictum-derive)/src/|(^|/)Cargo\\.(toml|lock)$|^rust-toolchain\\.toml$\tnostd msrv\t'
  $'(^|/)Cargo\\.(toml|lock)$|^deny\\.toml$\tdeny\t'
  $'^fuzz/|^crates/dictum-testkit/\tfuzz-build\t'
  $'^crates/dictum/benches/\tbench-build\t'
  $'^tests/conformance/|^crates/dictum/benches/go/\tconformance-go\t'
  $'^crates/[^/]+/tests/|^crates/dictum-testkit/|(^|/)Cargo\\.lock$|^justfile$\twasm\tTests read files by compiled-in paths and run one at a time under wasmtime.'
  $'^crates/dictum-testkit/src/lib\\.rs$\tpending\tIf a milestone is complete, raise MILESTONE and remove its ignores.'
)

out=$root/target/verify
logs=$out/logs
rm -rf "$logs"
mkdir -p "$logs"
summary=$out/summary.md
failed=0
rows=()

# step NAME COMMAND...: runs COMMAND with its output in logs/NAME.log.
step() {
  local name=$1 log=$logs/$1.log started status=0
  shift
  started=$(date +%s)
  "$@" >"$log" 2>&1 || status=$?
  local took=$(($(date +%s) - started))s
  if ((status == 0)); then
    printf 'pass  %-16s %5s  %s\n' "$name" "$took" "${log#"$root"/}"
    rows+=("| $name | pass | $took | \`${log#"$root"/}\` |")
  else
    printf 'FAIL  %-16s %5s  %s\n' "$name" "$took" "${log#"$root"/}"
    rows+=("| $name | **fail** | $took | \`${log#"$root"/}\` |")
    tail -n 30 "$log" | sed 's/^/      /'
    failed=1
  fi
}

# Committed changes since the merge base, and uncommitted ones.
changed=$({
  git diff --name-only "$base"...HEAD --
  git diff --name-only HEAD --
  git ls-files --others --exclude-standard
} | sort -u)

recipes=()
notes=()
for trigger in "${TRIGGERS[@]}"; do
  IFS=$'\t' read -r pattern needs note <<<"$trigger"
  hits=$(grep -E -- "$pattern" <<<"$changed" || true)
  [ -n "$hits" ] || continue
  for recipe in $needs; do
    [[ " ${recipes[*]} " == *" $recipe "* ]] || recipes+=("$recipe")
  done
  if [ -n "$note" ]; then
    first=$(head -n 1 <<<"$hits")
    (($(wc -l <<<"$hits") == 1)) || first="$first and others"
    notes+=("- $first: $note")
  fi
done

case $mode in
check)
  step fmt just fmt
  step lint just lint
  step test just test
  step hatches just hatches "$base"
  for recipe in "${recipes[@]}"; do
    step "$recipe" just "$recipe"
  done
  ;;
full)
  step ci just ci
  step hatches just hatches "$base"
  ;;
deep)
  step test env PROPTEST_CASES=100000 just test
  step drt env PROPTEST_CASES=100000 just drt
  ;;
esac

# Tests reported as ignored, and why the differential tests were.
# The wasm step ignores them by design (WASI starts no processes), so only the
# host test run counts.
ignored=$(grep -hoE 'differential tests ignored: .*' "$logs"/test.log 2>/dev/null | sort -u || true)
skipped=$(grep -hoE '[0-9]+ tests? run: .*' "$logs"/test.log 2>/dev/null || true)

{
  echo "# Verification"
  echo
  echo "Revision $(git rev-parse --short HEAD), compared with $base; mode \`$mode\`."
  if ! git diff --quiet HEAD --; then
    echo "The working tree has changes that are not committed."
  fi
  echo
  echo "| Step | Result | Time | Log |"
  echo "|---|---|---|---|"
  printf '%s\n' "${rows[@]}"
  if [ -n "$skipped" ]; then
    echo
    echo "nextest: $(paste -sd ';' <<<"$skipped" | sed 's/;/; /g')."
  fi
  if [ -n "$ignored" ]; then
    echo
    echo "Ignored, so not evidence: $ignored. \`just drt\` builds the oracle and fails instead of skipping."
  fi
  if ((${#notes[@]} > 0)); then
    echo
    echo "## What the changed files also need"
    echo
    printf '%s\n' "${notes[@]}"
  fi
  if [ "$mode" = check ]; then
    echo
    if ((${#recipes[@]} > 0)); then
      echo "Recipes added for the changed files: ${recipes[*]}."
    fi
    echo "Not run in this mode: the rest of \`just ci\` (\`scripts/verify full\`) and the deep runs (\`scripts/verify deep\`)."
  fi
  echo
  echo "Invariants and their evidence: docs/verification.md."
} >"$summary"

echo "summary: ${summary#"$root"/}"
exit "$failed"
